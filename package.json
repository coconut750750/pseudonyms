  "scripts": {
    "client": "cd client && npm start",
    "server": "node --watch server.js",
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "test": "jest",
    "start": "node server.js",
    "build": "cd client && npm ci --include=dev && npm run build"
  },
  "dependencies": {
    "body-parser": "^1.19.0",
    "dotenv": "^8.2.0",
    "express": "^4.16.4",
    "express-rate-limit": "^5.1.3",
    "lodash": "^4.17.21",
    "mongoose": "^5.9.18",
    "socket.io": "^2.4.0"
  },
  "devDependencies": {
    "concurrently": "^4.0.1",
    "jest": "^24.9.0"
  },
  "engines": {
    "node": "25.2.1"
  }
}
